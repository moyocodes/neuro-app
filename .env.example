# console.anthropic.com → API Keys. Powers AI goal suggestions.
# WARNING: this ships in the browser bundle (client-side call, no backend
# yet) — anyone who opens devtools can read it. Personal-use only; never
# deploy this build publicly. See README "AI goal suggestions".
VITE_ANTHROPIC_API_KEY=

# Supabase project — Project Settings → API in the Supabase dashboard.
# VITE_SUPABASE_ANON_KEY is the "anon public" key (safe for the browser;
# RLS policies enforce access) — never put the "service_role" key here.
VITE_SUPABASE_URL=https://qntpoyvlamhizmgkkokf.supabase.co
VITE_SUPABASE_ANON_KEY=

# Web Push VAPID key pair — generate with `npx web-push generate-vapid-keys`.
# The public key goes here (safe for the browser); the matching private
# key is a Supabase Edge Function secret (VAPID_PRIVATE_KEY), never in
# this file. See README "Reminders / alarms with notes".
VITE_VAPID_PUBLIC_KEY=
